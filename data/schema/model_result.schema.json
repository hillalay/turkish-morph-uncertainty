{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:turkish-llm-morphology:schema:model-result:v1",
  "title": "Model evaluation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id",
    "model_id",
    "model_revision",
    "evaluation_config_id",
    "status",
    "token_count",
    "token_logprobs",
    "word_nll",
    "token_normalized_nll",
    "alignment",
    "error"
  ],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "model_id": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "minLength": 1},
    "evaluation_config_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["ok", "alignment_error"]},
    "token_count": {"type": ["integer", "null"], "minimum": 1},
    "token_logprobs": {
      "type": ["array", "null"],
      "items": {"type": "number"},
      "minItems": 1
    },
    "word_nll": {"type": ["number", "null"], "minimum": 0},
    "token_normalized_nll": {"type": ["number", "null"], "minimum": 0},
    "alignment": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["target_char_span", "target_token_indices", "target_token_char_spans"],
      "properties": {
        "target_char_span": {"$ref": "#/$defs/span"},
        "target_token_indices": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        },
        "target_token_char_spans": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/span"}
        }
      }
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"const": "TARGET_ALIGNMENT_FAILED"},
        "message": {"type": "string", "minLength": 1}
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": {"const": "ok"},
        "token_count": {"type": "integer", "minimum": 1},
        "token_logprobs": {"type": "array", "minItems": 1},
        "word_nll": {"type": "number", "minimum": 0},
        "token_normalized_nll": {"type": "number", "minimum": 0},
        "alignment": {"type": "object"},
        "error": {"type": "null"}
      }
    },
    {
      "properties": {
        "status": {"const": "alignment_error"},
        "token_count": {"type": "null"},
        "token_logprobs": {"type": "null"},
        "word_nll": {"type": "null"},
        "token_normalized_nll": {"type": "null"},
        "alignment": {"type": "null"},
        "error": {"type": "object"}
      }
    }
  ],
  "$defs": {
    "span": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  }
}
